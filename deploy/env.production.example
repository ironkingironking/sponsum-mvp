NODE_ENV=production
API_PORT=3088
API_HOST=127.0.0.1
DATABASE_URL=postgresql://sponsum:sponsum@127.0.0.1:5432/sponsum?schema=public
AUTH_SECRET=replace-with-32-plus-character-secret
CORS_ORIGIN=https://suite.movena.ch
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000
SPONSUM_STORE_PATH=/opt/docker/movena-sponsum/data/store.json
MOVENA_ERPNEXT_URL=http://127.0.0.1:8090
MOVENA_ERPNEXT_SITE=erp.movena.ch
SKRIBBLE_USERNAME=
SKRIBBLE_API_KEY=
SKRIBBLE_BASE_URL=https://api.skribble.com/v2
SKRIBBLE_LEGISLATION=ZERTES
# Same OpenAI Responses setup as Movena OCR Settings / site_config.
OPENAI_API_KEY=
OPENAI_RESPONSES_ENDPOINT=https://api.openai.com/v1/responses
OPENAI_MODEL=gpt-5.5
MOVENA_FULFILMENT_CASE_PATH=/opt/docker/movena-growth/data/fulfilment-cases.json
# Settlement webhooks (audit DK-31): file with one line, the provider's HMAC secret (32+ characters, from the secret
# store). Empty = provider webhooks are refused; payments are then confirmed manually by a second admin with the bank
# booking reference.
SPONSUM_SETTLEMENT_WEBHOOK_SECRET_FILE=
